# URL publique de l'application (liens de partage, code d'intégration)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Origines autorisées à piloter le viewer embarqué via postMessage (séparées par des virgules)
NUXT_PUBLIC_EMBED_ALLOWED_ORIGINS=

# --- Base de données (Neon) ---
# Chaîne de connexion Neon (Vercel → Storage → Neon, ou console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Authentification (Better Auth) ---
# Secret de 32 octets minimum : npm run auth:secret
BETTER_AUTH_SECRET=
# URL de l'app (en production : l'URL Vercel ou ton domaine)
BETTER_AUTH_URL=http://localhost:3000

# Connexion Google (facultatif) : le bouton apparaît dès que les deux sont renseignés.
# URI de redirection à déclarer chez Google : <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails (Resend) ---
# Clé API Resend. Sans clé, en local, le lien de confirmation s'affiche dans le terminal.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend (onboarding@resend.dev : tests uniquement)
EMAIL_FROM="Oh My Desk <noreply@ton-domaine.fr>"

# --- Fichiers (Vercel Blob) : aperçus PNG, modèles GLB ---
# Jeton du store Blob (Vercel → Storage → Blob, ou `vercel env pull`).
# Sans jeton, en local, les fichiers sont écrits dans .data/blob et servis sur /blob/**.
BLOB_READ_WRITE_TOKEN=
# Racine publique des modèles GLB : déduite du jeton par défaut, à surcharger seulement si besoin.
# NUXT_PUBLIC_ASSETS_BASE_URL=
